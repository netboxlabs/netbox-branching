---
# YAML lint config for the yamllint pre-commit hook.
# Adapted from netbox-plugin-scaffold's own root config; the scaffold does not
# render one into generated plugins, but the hook it ships needs one.

extends: default

rules:
  line-length:
    max: 120
    level: warning
  truthy:
    check-keys: false
  document-start: disable
  comments:
    min-spaces-from-content: 1

ignore: |
  .git/
  site/
  .cache/
